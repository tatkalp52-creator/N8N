    {
      "parameters": {
        "jsCode": "const trigger = $('Telegram Trigger').first().json;\nconst msg = trigger.message || {};\n\nlet textToSearch = msg.text || msg.caption || '';\nif (msg.reply_to_message) {\n  const replyMsg = msg.reply_to_message;\n  textToSearch += ' ' + (replyMsg.text || replyMsg.caption || '');\n}\n\nconst match = textToSearch.match(/(\\d{8})_?(\\d{6})_?([A-Za-z0-9]+)/);\n\nif (match) {\n  const projectId = match[1] + '_' + match[2] + '_' + match[3];\n  let userText = msg.text || msg.caption || '';\n  if (userText.includes(match[0])) {\n    userText = userText.replace(match[0], '').replace(/ID\\s*:?/gi, '').trim();\n  }\n  return [{\n    json: {\n      isBrief: true,\n      projectId,\n      channelKey: match[3],\n      briefText: userText,\n      chatId: msg.chat.id,\n      photo: msg.photo || null,\n    }\n  }];\n} else {\n  return [{ json: { isBrief: false, chatId: msg.chat ? msg.chat.id : null } }];\n}"
      },
