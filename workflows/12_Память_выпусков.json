      "executeOnce": true,
      "id": "93a94291-c921-4418-98fb-541875edb3be"
    },
    {
      "parameters": {
        "jsCode": "// Разовая загрузка прошлых выпусков в векторную память канала.\n// Берём утверждённые/опубликованные выпуски, по одной карточке на выпуск.\nconst tmpl = $('Читаем шаблон канала').first().json || {};\nconst key = Object.keys(tmpl).find(k => k.replace(/^[^a-zA-Z]+/, '') === 'tmpl_ChannelVectorStoreId');\nconst vsId = String(key ? tmpl[key] : '').trim();\nif (!vsId) throw new Error('В Templates нет tmpl_ChannelVectorStoreId для канала');\nconst out = [];\nfor (const it of $('Читаем выпуски').all()) {\n  const r = it.json || {};\n  const id = String(r.sys_ProjectID || '').trim();\n  const st = String(r.sys_Status || '').trim();\n  const story = String(r.ai_DescriptionDraft || r.ai_Description || '').trim();\n  if (!id || !story || !['Утверждено', 'Опубликовано'].includes(st)) continue;\n  const m = id.match(/^(\\d{4})(\\d{2})(\\d{2})/);\n  const theme = (String(r.ai_Description || '').split('\\n').find(l => l.trim().startsWith('♪')) || '').trim();\n  const text = [\n    `ВЫПУСК КАНАЛА «jazzt a Pengui» · ${m ? m[3] + '.' + m[2] + '.' + m[1] : ''} · ID ${id}`,\n    `Название: ${r.ai_Title || ''}`,\n    `Оверлей: ${r.ai_OverlayText || ''}`,\n    theme ? `Музыкальная тема: ${theme}` : '',\n    r.ai_UserBrief ? `Замысел автора: ${r.ai_UserBrief}` : '',\n    '', 'История (как её согласовала автор):', story, '',\n    'Названия треков: ' + String(r.ai_TimecodeNames || '').split('\\n').filter(Boolean).join(' · '),\n  ].join('\\n');\n  out.push({ json: { vsId, id }, binary: { data: { data: Buffer.from(text, 'utf8').toString('base64'), mimeType: 'text/plain', fileName: `episode_${id}.txt` } } });\n}\nif (!out.length) throw new Error('Нет утверждённых выпусков с описанием');\nreturn out;"
      },
